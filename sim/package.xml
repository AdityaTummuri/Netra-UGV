<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim</name>
  <version>1.0.0</version>
  <description>
    Simulation subsystem for NETRA-UGV off-road autonomous navigation in Gazebo Garden/Harmonic.
    Includes tactical obstacle world, UGV skid-steer chassis URDF/SDF, and sensor bridges.
  </description>
  <maintainer email="team@netra-ugv.in">NETRA-UGV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>netra_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
